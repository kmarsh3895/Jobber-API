# Copy these names into Vercel's Environment Variables settings (Project → Settings → Environment Variables).
# Never put real values in this file — it's just a checklist of what's needed.

# From Jobber's Developer Center (Manage Apps → your app → OAuth & access scopes)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# The real address of your deployed site's callback page.
# Looks like: https://your-project-name.vercel.app/api/jobber-callback
JOBBER_REDIRECT_URI=

# These two get added AUTOMATICALLY when you connect the Upstash Redis
# storage integration in Vercel (Storage tab → Browse Marketplace → Redis).
# You do not need to type these in yourself.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
